# انسخ هذا الملف إلى .env.local واملأ القيم من لوحة Supabase.
# Copy this file to .env.local and fill in the values from your Supabase dashboard.

# Connect → App Frameworks → Next.js (تقدر تلصق السطرين كما هما من هناك)
# The key line may also be named NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY; both names work.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Connect → Session pooler → URI (استبدل [YOUR-PASSWORD] بكلمة مرور قاعدة البيانات كما هي، حتى لو فيها رموز)
# Used only by `npm run db:migrate` on your machine. Never commit it.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# إيميلك أنت (يصبح حسابه admin تلقائياً). يمكن وضع أكثر من إيميل مفصولة بفاصلة.
ADMIN_EMAIL=you@example.com

# الكود الذي تعطيه لأصحابك ليسجّلوا. بدونه لا يقدر أحد يسجّل.
INVITE_CODE=change-me
